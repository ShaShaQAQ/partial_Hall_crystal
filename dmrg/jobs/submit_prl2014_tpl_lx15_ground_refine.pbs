#!/bin/bash
#PBS -N phc_tpl_lx15_ref
#PBS -q cmt
#PBS -l nodes=1:ppn=24
#PBS -l walltime=120:00:00
#PBS -j oe
#PBS -o /home/public/shajy/partial_Hall_crystal/dmrg/logs/prl2014_tpl_lx15_refine.$PBS_JOBID.out

set -euo pipefail

cd /home/public/shajy/partial_Hall_crystal

BASE_OUT=${BASE_OUT:-dmrg/output_prl2014_tpl_Lx15_Np36_V10_2_2}
OUTROOT=${OUTROOT:-dmrg/output_prl2014_tpl_Lx15_Np36_V10_2_2_refine_chi3000}
THREADS=${THREADS:-${PBS_NP:-24}}

if [ "$THREADS" -gt 24 ]; then
  echo "THREADS=$THREADS exceeds node ppn=24"
  exit 2
fi

mkdir -p dmrg/logs "$OUTROOT"

export LC_ALL=C
export LANG=C
export JULIA_PKG_OFFLINE=true
export JULIA_NUM_THREADS="$THREADS"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

echo "Job started at $(date)"
echo "Host: $(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-none}"
echo "BASE_OUT=$BASE_OUT"
echo "OUTROOT=$OUTROOT"
echo "JULIA_NUM_THREADS=$JULIA_NUM_THREADS"
echo "Working directory: $(pwd)"
echo "PRL2014 TPL refine: Lx=15 Ly=6 Ns=90 Nuc=45 Np=36"
echo "Parameters: t1=1.0 t3=0.2 V1=10.0 V2=2.0 V3=2.0"
echo "Note: previous run did not save an MPS checkpoint; this run uses BASE_OUT/density.dat as a density-biased product seed and writes a reusable checkpoint."

test -s "$BASE_OUT/density.dat"

julia -t "$THREADS" --project=. dmrg/run_dmrg.jl \
  --Lx=15 --Ly=6 --Np=36 \
  --t1=1.0 --t3=0.2 \
  --V1=10.0 --V2=2.0 --V3=2.0 \
  --threaded_blocksparse=true \
  --blas_threads=1 \
  --disable_strided_threads=true \
  --adaptive=true \
  --nsweeps=70 \
  --max_sweeps=70 \
  --min_sweeps=10 \
  --target_maxdim=3000 \
  --stable_sweeps=3 \
  --maxdim=400,800,1200,1600,2000,2400,2800,3000 \
  --cutoff=1e-9 \
  --energy_tol=1e-6 \
  --density_tol=2e-5 \
  --truncerr_tol=5e-8 \
  --seed=4321 \
  --init_linkdim=32 \
  --init_density="$BASE_OUT/density.dat" \
  --checkpoint_out="$OUTROOT/checkpoint_final.jls" \
  --output="$OUTROOT" \
  2>&1 | tee "dmrg/logs/prl2014_tpl_lx15_refine.live.${PBS_JOBID:-manual}.log"

test -s "$OUTROOT/summary.dat"
test -s "$OUTROOT/density.dat"
test -s "$OUTROOT/density_x.dat"
test -s "$OUTROOT/connected_density.dat"
test -s "$OUTROOT/checkpoint_final.jls"

echo "Job finished at $(date)"
echo "Output: $OUTROOT"

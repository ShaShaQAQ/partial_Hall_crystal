#!/bin/bash
#PBS -N phc_dmrg_lx15_adapt
#PBS -q cmt
#PBS -l nodes=1:ppn=24
#PBS -l walltime=120:00:00
#PBS -j oe
#PBS -o /home/public/shajy/partial_Hall_crystal/dmrg/logs/lx15_adaptive.$PBS_JOBID.out

set -euo pipefail

cd /home/public/shajy/partial_Hall_crystal

mkdir -p dmrg/logs dmrg/output_Lx15_adaptive_chi3200

export JULIA_PKG_OFFLINE=true
export JULIA_NUM_THREADS=${PBS_NP:-24}
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

echo "Job started at $(date)"
echo "Host: $(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-none}"
echo "JULIA_NUM_THREADS=$JULIA_NUM_THREADS"
echo "Working directory: $(pwd)"

julia --project=. dmrg/run_dmrg.jl \
  --Lx=15 --Ly=6 --Np=15 \
  --t1=1.0 --t3=0.2 \
  --V1=1.0 --V2=0.0 --V3=0.0 \
  --adaptive=true \
  --nsweeps=36 \
  --max_sweeps=36 \
  --min_sweeps=14 \
  --maxdim=200,400,800,1200,1600,2400,3200 \
  --cutoff=1e-9 \
  --energy_tol=5e-8 \
  --density_tol=2e-5 \
  --truncerr_tol=5e-8 \
  --output=dmrg/output_Lx15_adaptive_chi3200 \
  2>&1 | tee "dmrg/logs/lx15_adaptive.live.${PBS_JOBID:-manual}.log"

echo "Job finished at $(date)"

#!/bin/bash
#PBS -N phc30_fq_optical
#PBS -q short
#PBS -l select=1:ncpus=24:mem=90gb
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail

W003_REPO=${W003_REPO:-/home/public/shajy/codex/partial_Hall_crystal-ed-excitations}
PHC_RUN_DIR=${PHC_RUN_DIR:-/home/public/shajy/codex_runs/phc30_np12_v1_10_v2_2_v3_2_fqahc}
PHC_DATA_DIR=${PHC_DATA_DIR:-${PHC_RUN_DIR}/spectrum}
PHC_OUTPUT_DIR=${PHC_OUTPUT_DIR:-${PHC_RUN_DIR}/optical}
PHC_SECTOR=${PHC_SECTOR:-5}
PHC_MMAX=${PHC_MMAX:-600}
PHC_PREFLIGHT=${PHC_PREFLIGHT:-0}
JULIA_BIN=${JULIA_BIN:-/home/shajy/bin/julia}

export JULIA_NUM_THREADS=24
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export PHC_BLAS_THREADS=1

arguments=(
    --sector "${PHC_SECTOR}"
    --mmax "${PHC_MMAX}"
    --data-dir "${PHC_DATA_DIR}"
    --out-dir "${PHC_OUTPUT_DIR}"
    --lattice corrected
    --t1 1.0 --t3 0.2 --V1 10.0 --V2 2.0 --V3 2.0
)
if [[ "${PHC_PREFLIGHT}" == "1" ]]; then
    arguments+=(--preflight)
fi

mkdir -p "${PHC_OUTPUT_DIR}"
cd "${W003_REPO}"
exec "${JULIA_BIN}" --threads=24 --project=. \
    ed/cases/case3_30sites_Np12/run_optical_response.jl \
    "${arguments[@]}"

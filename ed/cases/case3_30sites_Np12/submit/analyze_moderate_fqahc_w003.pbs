#!/bin/bash
#PBS -N phc30_fq_analyze
#PBS -q short
#PBS -l select=1:ncpus=24:mem=90gb
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail

W003_REPO=${W003_REPO:-/home/public/shajy/codex/partial_Hall_crystal-ed-excitations}
PHC_RUN_DIR=${PHC_RUN_DIR:-/home/public/shajy/codex_runs/phc30_np12_v1_10_v2_2_v3_2_fqahc}
PHC_DATA_DIR=${PHC_DATA_DIR:-${PHC_RUN_DIR}/spectrum}
PHC_RESULT_DIR=${PHC_RESULT_DIR:-${W003_REPO}/results/phc30_np12_v1_10_v2_2_v3_2_fqahc}
JULIA_BIN=${JULIA_BIN:-/home/shajy/bin/julia}

export JULIA_NUM_THREADS=24
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

cd "${W003_REPO}"
exec "${JULIA_BIN}" --threads=24 --project=. \
    ed/cases/case3_30sites_Np12/analyze_ground_manifold.jl \
    --data-dir "${PHC_DATA_DIR}" \
    --result-dir "${PHC_RESULT_DIR}" \
    --manifold-size 15 \
    --lattice corrected

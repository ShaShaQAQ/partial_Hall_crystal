#!/bin/bash
#PBS -N phc30_fq_spectrum
#PBS -q short
#PBS -l select=1:ncpus=24:mem=90gb
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail

W003_REPO=${W003_REPO:-/home/public/shajy/codex/partial_Hall_crystal-ed-excitations}
PHC_RUN_DIR=${PHC_RUN_DIR:-/home/public/shajy/codex_runs/phc30_np12_v1_10_v2_2_v3_2_fqahc}
PHC_DATA_DIR=${PHC_DATA_DIR:-${PHC_RUN_DIR}/spectrum}
if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    PHC_SECTOR_START=${PBS_ARRAY_INDEX}
    PHC_SECTOR_END=${PHC_SECTOR_START}
else
    PHC_SECTOR_START=${PHC_SECTOR_START:-0}
    PHC_SECTOR_END=${PHC_SECTOR_END:-${PHC_SECTOR_START}}
fi
PHC_NEV=${PHC_NEV:-8}
PHC_KRYLOVDIM=${PHC_KRYLOVDIM:-60}
JULIA_BIN=${JULIA_BIN:-/home/shajy/bin/julia}

export JULIA_NUM_THREADS=24
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=4

mkdir -p "${PHC_DATA_DIR}"
cd "${W003_REPO}"
exec "${JULIA_BIN}" --threads=24 --project=. \
    ed/cases/case3_30sites_Np12/run_spectrum.jl \
    --sector-start "${PHC_SECTOR_START}" \
    --sector-end "${PHC_SECTOR_END}" \
    --output-dir "${PHC_DATA_DIR}" \
    --lattice corrected \
    --t1 1.0 --t3 0.2 --V1 10.0 --V2 2.0 --V3 2.0 \
    --Np 12 --nev "${PHC_NEV}" --krylovdim "${PHC_KRYLOVDIM}"

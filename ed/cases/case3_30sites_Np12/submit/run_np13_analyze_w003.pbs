#!/bin/bash
#PBS -N phc30_n13_an
#PBS -q short
#PBS -l select=1:ncpus=24:mem=90gb
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail

: "${PHC_RESULT_ID:?set PHC_RESULT_ID}"
: "${PHC_V1:?set PHC_V1}"
: "${PHC_V2:?set PHC_V2}"
: "${PHC_V3:?set PHC_V3}"
: "${PHC_MANIFOLD_SIZE:?set PHC_MANIFOLD_SIZE after inspecting the spectrum}"
: "${PHC_PHASE_LABEL:?set PHC_PHASE_LABEL conservatively}"

W003_REPO=${W003_REPO:-/home/public/shajy/codex/partial_Hall_crystal-ed-excitations}
PHC_RUN_ROOT=${PHC_RUN_ROOT:-/home/public/shajy/codex_runs}
PHC_DATA_DIR=${PHC_DATA_DIR:-${PHC_RUN_ROOT}/${PHC_RESULT_ID}/spectrum}
PHC_RESULT_DIR=${PHC_RESULT_DIR:-${W003_REPO}/results/${PHC_RESULT_ID}}
JULIA_BIN=${JULIA_BIN:-/home/shajy/bin/julia}

export JULIA_NUM_THREADS=24
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

cd "${W003_REPO}"
exec "${JULIA_BIN}" --threads=24 --project=. \
    ed/cases/case3_30sites_Np12/analyze_ground_manifold.jl \
    --data-dir "${PHC_DATA_DIR}" --result-dir "${PHC_RESULT_DIR}" \
    --result-id "${PHC_RESULT_ID}" \
    --phase-label "${PHC_PHASE_LABEL}" \
    --manifold-size "${PHC_MANIFOLD_SIZE}" \
    --lattice corrected --Np 13 \
    --t1 1.0 --t3 0.2 \
    --V1 "${PHC_V1}" --V2 "${PHC_V2}" --V3 "${PHC_V3}"

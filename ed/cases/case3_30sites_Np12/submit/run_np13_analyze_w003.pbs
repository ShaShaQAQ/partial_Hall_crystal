#!/bin/bash
#PBS -N phc30_n13_an
#PBS -q short
#PBS -l select=1:ncpus=24:mem=90gb
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail

# Encode the inspected manifold size in the preserved PBS job name, for example
# `qsub -N phc13s_m3` or `qsub -N phc13m_m15`.
case "${PBS_JOBNAME:-}" in
    phc13s_m*)
        PHC_RESULT_ID=phc30_np13_v1_100_v2_0_v3_0
        PHC_V1=100.0
        PHC_V2=0.0
        PHC_V3=0.0
        PHC_MANIFOLD_SIZE=${PBS_JOBNAME#phc13s_m}
        PHC_PHASE_LABEL="Np=13 strong-coupling low-energy manifold"
        ;;
    phc13m_m*)
        PHC_RESULT_ID=phc30_np13_v1_10_v2_2_v3_2
        PHC_V1=10.0
        PHC_V2=2.0
        PHC_V3=2.0
        PHC_MANIFOLD_SIZE=${PBS_JOBNAME#phc13m_m}
        PHC_PHASE_LABEL="Np=13 moderate-coupling candidate manifold"
        ;;
esac

: "${PHC_RESULT_ID:?use PBS_JOBNAME phc13s_mN or phc13m_mN}"
: "${PHC_V1:?missing preset V1}"
: "${PHC_V2:?missing preset V2}"
: "${PHC_V3:?missing preset V3}"
: "${PHC_MANIFOLD_SIZE:?encode the manifold size in PBS_JOBNAME}"
: "${PHC_PHASE_LABEL:?missing preset phase label}"
[[ "${PHC_MANIFOLD_SIZE}" =~ ^[1-9][0-9]*$ ]] || {
    echo "invalid manifold size in PBS_JOBNAME: ${PBS_JOBNAME}" >&2
    exit 2
}

W003_REPO=${W003_REPO:-/home/public/shajy/codex/partial_Hall_crystal-ed-excitations}
PHC_RUN_ROOT=${PHC_RUN_ROOT:-/home/public/shajy/codex_runs}
PHC_DATA_DIR=${PHC_DATA_DIR:-${PHC_RUN_ROOT}/${PHC_RESULT_ID}/spectrum}
PHC_RESULT_DIR=${PHC_RESULT_DIR:-${W003_REPO}/results/${PHC_RESULT_ID}}
JULIA_BIN=${JULIA_BIN:-/home/shajy/bin/julia}

export JULIA_NUM_THREADS=24
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

cd "${W003_REPO}"
exec "${JULIA_BIN}" --threads=24 --project=. \
    ed/cases/case3_30sites_Np12/analyze_ground_manifold.jl \
    --data-dir "${PHC_DATA_DIR}" --result-dir "${PHC_RESULT_DIR}" \
    --result-id "${PHC_RESULT_ID}" \
    --phase-label "${PHC_PHASE_LABEL}" \
    --manifold-size "${PHC_MANIFOLD_SIZE}" \
    --lattice corrected --Np 13 \
    --t1 1.0 --t3 0.2 \
    --V1 "${PHC_V1}" --V2 "${PHC_V2}" --V3 "${PHC_V3}"
